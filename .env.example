# Скопируйте в .env и настройте по необходимости; .env указан в .gitignore и никогда не коммитится.
# Здесь должны быть только переменные, которые реально читает docker-compose.yml — полный список
# переменных, которые понимает само приложение, см. в README.

# Пароль PostgreSQL, общий для сервисов db и backend.
# Значение по умолчанию (heat-local-dev) подходит для локальной однокомпьютерной установки.
DB_PASSWORD=heat-local-dev

# Локальный порт, на котором публикуются веб-интерфейс и API.
HTTP_PORT=8080

# Лимит памяти для контейнера backend (куча JVM = 75% от этого значения).
# Увеличьте для больших импортов (см. README, "Хранение данных").
BACKEND_MEMORY=1g
